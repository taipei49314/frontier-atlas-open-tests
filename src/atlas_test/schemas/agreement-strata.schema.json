{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontier-atlas.invalid/schemas/agreement-strata-v1.json",
  "title": "Frontier Atlas private agreement stratum row v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["assignment_id", "severity", "slices"],
  "properties": {
    "assignment_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "severity": {"enum": ["low", "medium", "high", "critical"]},
    "slices": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}
    }
  }
}
